# Copy to .env.local and fill from Firebase console > Project settings > Your apps > Web app.
# Leave empty to run the on-device part only ("cloud step off").
# Optional: cloud model used for the dish-names-only step.
VITE_APPCHECK_DEBUG_TOKEN=
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_RECAPTCHA_V3_KEY=
